# ==============================================================
# STARVAULT — TELEGRAM STARS & PREMIUM STORE CONFIGURATION
# ==============================================================

# 1. Telegram Bot & WebApp
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAExampleTelegramBotTokenHere
# Telegram ID администраторов (через запятую)
ADMIN_TELEGRAM_IDS=123456789,987654321
# Секретный ключ для HMAC-сессий и подписей
SECRET_KEY=change-me-to-a-very-long-random-string-64-chars
# Публичный HTTPS URL сайта / Mini App (например https://yourdomain.com или Ngrok)
WEB_APP_URL=https://yourdomain.com

# 2. Провайдеры выдачи Stars и Premium
# Выбор провайдера по умолчанию: 'mystars' или 'greengame' (переключается в /admin)
ACTIVE_PROVIDER=mystars

# ==============================================================
# MyStars FaaS Fulfilment API (https://mystars.tg/docs)
# ==============================================================
# API-ключ выдаётся в боте @my_stars_tg_bot (кнопка "API access" -> X-Api-Key)
MYSTARS_API_KEY=ms_live_your_mystars_api_key
# Базовый адрес API MyStars
MYSTARS_BASE_URL=https://api.mystars.tg
# Секрет для проверки вебхуков X-FaaS-Signature (HMAC-SHA256)
MYSTARS_WEBHOOK_SECRET=your_mystars_webhook_secret
# Валюта оплаты заказа в MyStars: 'ton' (GRAM) или 'usdt_ton' (USDT в сети TON)
MYSTARS_PAYMENT_CURRENCY=ton

# Мнемоника кошелька TON (опционально, для автономного покрытия комиссий и газа)
TON_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# Провайдер 2: GreenGamePay API (альтернативный шлюз)
GREENGAME_API_KEY=gg_live_your_greengame_api_key

# 3. Платёжные шлюзы для клиентов
# CryptoBot (API токен от @CryptoBot)
CRYPTOBOT_TOKEN=12345:AAExampleCryptoBotApiToken

# ЮKassa (Банковские карты / СБП)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_your_yookassa_secret_key

# ЮMoney (Карты / P2P переводы с автосверкой по метке)
YOOMONEY_RECEIVER=410011234567890
YOOMONEY_SECRET=your_yoomoney_notification_secret

# 4. База данных и Сеть
DATABASE_PATH=/home/user/telegram_stars_store/store.db
HOST=0.0.0.0
PORT=8000
